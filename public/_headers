# Cloudflare Pages: pages always re-check for a new version, hashed assets are cached for a year.
/*
  Cache-Control: public, max-age=0, must-revalidate
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Images and videos beside the case study and article pages: one day. The pages themselves keep the /* rule.
/work/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=86400
/work/*.mp4
  ! Cache-Control
  Cache-Control: public, max-age=86400
/writing/*.webp
  ! Cache-Control
  Cache-Control: public, max-age=86400

# Free skill files: shown as text in the browser, so people can read before they save (28 Nov 2026).
/skills/*
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

# Long cache for fonts and images. Files are versioned with ?v= when they change.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/vendor/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/hero/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/me/ai/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/me/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/work/cut/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/work/wall/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/work/fan/*
  ! Cache-Control
