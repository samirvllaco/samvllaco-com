# Cloudflare Pages: pages always re-check for a new version, hashed assets are cached for a year.
/*
  Cache-Control: public, max-age=0, must-revalidate
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/work/*
  Cache-Control: public, max-age=86400
/writing/*
  Cache-Control: public, max-age=86400

# Long cache for fonts and images. Files are versioned with ?v= when they change.
/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/hero/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/work/cut/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/work/wall/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000
/work/fan/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000
/social/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000
/people/*
  ! Cache-Control
  Cache-Control: public, max-age=2592000
